# syntax=docker/dockerfile:1.7
# Imagen del panel (ADR-0012). engine-strict (frontend/.npmrc) hace fallar el build si Node < 22.22.3.
FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build -- --configuration production

FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
COPY infra/nginx.conf /etc/nginx/conf.d/default.conf
# Fuera de conf.d/ para que no se incluya a nivel http; solo lo incluyen las location del panel.
COPY infra/nginx-cabeceras-panel.conf /etc/nginx/cabeceras-panel.conf
COPY --from=builder /app/dist/panel/browser /usr/share/nginx/html
USER 101
EXPOSE 8080

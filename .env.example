# Copia a .env y completa. NUNCA subas .env al repositorio.
ENV=development                      # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO

# Base de datos (se crea sola en el primer arranque si DB_AUTO_CREATE=true)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agente_correo
DB_AUTO_CREATE=true
DB_ROLES_SEPARADOS=false

# Seguridad (genera valores con: make keys)
APP_MASTER_KEY=CAMBIAME_base64_de_32_bytes
JWT_SECRET=CAMBIAME_minimo_32_bytes_aleatorios
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7
CORS_ORIGENES=http://localhost:4200
ADMIN_INITIAL_EMAIL=admin@viamatica.local
ADMIN_INITIAL_PASSWORD=                    # vacío = se genera y se muestra una sola vez en logs
RED_PRIVADA_PERMITIDA=false

# Proveedores de IA (opcionales; también se cargan cifrados desde el panel)
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
FAKE_PROVIDERS=false                        # true = proveedores falsos para desarrollo y pruebas

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=                # vacío = sin exportación
OTEL_SERVICE_NAME=agente-correo
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend
API_BASE_URL=http://localhost:8000/api/v1

# Salud y despliegue (E0.1)
SALUD_BD_TIMEOUT_S=2.0                      # timeout de las sondas de /salud/listo, 0 < t <= 10
FORWARDED_ALLOW_IPS=127.0.0.1               # IP o CIDR del reverse proxy de confianza; nunca *
POSTGRES_DB=agente_correo                   # base que crea el contenedor db; debe coincidir con DATABASE_URL

# Base de datos autoconfigurable (E0.2). Cada bloque solo se añade si la variable no existía.
DATABASE_URL_MIGRADOR=postgresql+asyncpg://agente_migrador:CAMBIAME@localhost:5432/agente_correo   # solo el servicio migrador; obligatoria con DB_ROLES_SEPARADOS=true
DB_ESPERA_MAX_S=60                            # espera máxima a PostgreSQL, 0 < t <= 600
DB_BOOTSTRAP_LOCK_TIMEOUT_S=120               # espera del advisory lock, 0 < t <= 1800
POSTGRES_PASSWORD=CAMBIAME                   # superusuario del contenedor db; sin valor por defecto en Compose
AGENTE_MIGRADOR_PASSWORD=CAMBIAME             # rol agente_migrador (DDL, solo bootstrap)
AGENTE_APP_PASSWORD=CAMBIAME                   # rol agente_app (DML, usado por api y worker)

# Copia a .env y completa. NUNCA subas .env al repositorio.
ENV=development                      # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO

# Base de datos (se crea sola en el primer arranque si DB_AUTO_CREATE=true)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agente_correo
DB_AUTO_CREATE=true
DB_ROLES_SEPARADOS=false

# Seguridad (genera valores con: make keys)
APP_MASTER_KEY=CAMBIAME_base64_de_32_bytes
JWT_SECRET=CAMBIAME_minimo_32_bytes_aleatorios
JWT_ACCESS_MINUTOS=15
JWT_REFRESH_DIAS=7
CORS_ORIGENES=http://localhost:4200
ADMIN_INITIAL_EMAIL=admin@viamatica.local
ADMIN_INITIAL_PASSWORD=                    # vacío = se genera y se muestra una sola vez en logs
RED_PRIVADA_PERMITIDA=false

# Proveedores de IA (opcionales; también se cargan cifrados desde el panel)
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
FAKE_PROVIDERS=false                        # true = proveedores falsos para desarrollo y pruebas

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=                # vacío = sin exportación
OTEL_SERVICE_NAME=agente-correo
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Frontend
API_BASE_URL=http://localhost:8000/api/v1

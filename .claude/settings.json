{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git branch*)", "Bash(git add*)", "Bash(git commit*)",
      "Bash(git fetch*)", "Bash(git pull*)", "Bash(git push -u origin *)", "Bash(git stash*)", "Bash(git switch*)", "Bash(git checkout -b *)",
      "Bash(make *)", "Bash(ls*)", "Bash(find *)", "Bash(rg *)", "Bash(grep *)", "Bash(cat *)", "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(tree*)",
      "Bash(uv sync*)", "Bash(uv add*)", "Bash(uv lock*)", "Bash(uv run *)", "Bash(uvx *)",
      "Bash(npm install*)", "Bash(npm ci*)", "Bash(npm run *)", "Bash(npm test*)", "Bash(npm audit*)", "Bash(npx *)", "Bash(ng *)",
      "Bash(docker compose *)", "Bash(docker ps*)", "Bash(docker logs*)", "Bash(docker build*)",
      "Bash(python3 -c *)", "Bash(python3 -m json.tool *)", "Bash(bash -n *)", "Bash(chmod +x *)",
      "Read", "Glob", "Grep", "Edit", "Write", "WebSearch",
      "WebFetch(domain:docs.typesafe.ai)", "WebFetch(domain:docs.anthropic.com)", "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:docs.langchain.com)", "WebFetch(domain:langchain-ai.github.io)", "WebFetch(domain:angular.dev)",
      "WebFetch(domain:material.angular.dev)", "WebFetch(domain:fastapi.tiangolo.com)", "WebFetch(domain:docs.sqlalchemy.org)",
      "WebFetch(domain:alembic.sqlalchemy.org)", "WebFetch(domain:procrastinate.readthedocs.io)", "WebFetch(domain:pypi.org)", "WebFetch(domain:www.npmjs.com)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./**/.env)", "Read(./**/.env.local)", "Read(./**/.env.production)",
      "Read(./**/*.pem)", "Read(./**/*.key)", "Read(./**/*.p12)", "Read(./**/secrets/**)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "Edit(./.env)", "Edit(./.env.*)", "Write(./.env)", "Write(./.env.*)",
      "Bash(curl * | sh*)", "Bash(curl * | bash*)", "Bash(wget * | sh*)", "Bash(wget * | bash*)",
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git push origin main*)", "Bash(git push origin master*)",
      "Bash(rm -rf /*)", "Bash(rm -rf ~*)", "Bash(sudo *)", "Bash(docker system prune*)", "Bash(docker volume rm*)",
      "Bash(pip install*)", "Bash(pip3 install*)"
    ],
    "defaultMode": "default"
  },
  "env": {
    "FAKE_PROVIDERS": "true",
    "UV_NO_SYNC": "0",
    "PYTHONDONTWRITEBYTECODE": "1",
    "NG_CLI_ANALYTICS": "false",
    "DO_NOT_TRACK": "1"
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/sesion-inicio.sh", "timeout": 10 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bloquear-comandos.sh", "timeout": 10 } ] },
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/proteger-secretos.sh", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|Edit|MultiEdit", "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-lint.sh", "timeout": 90 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-verificar.sh", "timeout": 15 } ] }
    ]
  }
}
